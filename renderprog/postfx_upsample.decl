{
	newstyle

	state {
		depthWrite	0
		depthEnable	0
		depthfunc	ALWAYS
		cull none
	}

	hlsl_prefix {
		#include <vertex>
		#include <arkFiltering>
	}

	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord = $vertex_texcoord;
	}
	hlsl_fp_main {
		float2 textCoord = $texcoord * $(resolutionScale);
		@sv_target = BiCubicInterpolation( $(Identity/BufferIn), textCoord );
	}
}