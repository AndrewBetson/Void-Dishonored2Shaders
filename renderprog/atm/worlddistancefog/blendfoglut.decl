{
	newstyle
	options {
		NUMTHREADX 16
		NUMTHREADY 16
		NUMTHREADZ 4
	}
	hlsl_prefix {
//#define SHOW_COMPILER_BUG	// Define this to show evidence of compiler error when reading from SRVs using the [] operator
	}
	hlsl_cp_main
	{
		uint	FOG_LUT_WIDTH = 4096;			// Fog Luts are 4096x1 (don't forget to also change FOG_LUT_WIDTH in RenderView.h!)
		float	INV_FOG_LUT_WIDTH = (1.0 / FOG_LUT_WIDTH);

		uint2	TexelIndex = uint2( $sv_groupThreadID.x * 256 + $sv_groupThreadID.y * 16 + $sv_groupThreadID.z * 4 + $sv_groupID.x, 0 );

#ifdef SHOW_COMPILER_BUG
		float	V0 = $(atm/worldDistanceFog/blendFogLut/sourceFogLut)[TexelIndex].x;	// Reading from SRVs returns completely crazy results
		float	V1 = $(atm/worldDistanceFog/blendFogLut/targetFogLut)[TexelIndex].x;
#else
		float2	UV = float2( (0.5 + TexelIndex.x) * INV_FOG_LUT_WIDTH, 0.5 );
		float	V0 = $(atm/worldDistanceFog/blendFogLut/sourceFogLut).SampleLevel( $pointClamp, UV, 0.0 ).x;
		float	V1 = $(atm/worldDistanceFog/blendFogLut/targetFogLut).SampleLevel( $pointClamp, UV, 0.0 ).x;
#endif
		@(atm/worldDistanceFog/colorLUT)[TexelIndex] = lerp( V0, V1, $(atm/worldDistanceFog/blendFogLut/blendWeights).x );
	}
}