{
	newstyle

	options {
	}

	parms {
		stageSort	sortShadowWalk
	}
	
	state {
		blend ONE ZERO
		cull none
	}

	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord = $vertex_texcoord;
	}
	hlsl_fp_main {
		float2	UV = $texcoord.xy + $(subpixelOffset).xy;
		
		// compute pixel velocity introdued by camera motion
		float depth = $(rendering/DepthBufferIn).Sample( $linearClamp, UV ).x;

		float4 currentPos = float4( $sv_position.x*$positionToViewTexture.z*2.0-1.0, 1.0-$sv_position.y*$positionToViewTexture.w*2.0, depth, 1.0 );
		float4 wsPos = mul ( $inverseViewProjectionMatrix, currentPos );
		wsPos /= wsPos.w;
		float4 previousPos = mul ( $previousViewProjectionMatrix, wsPos );
		previousPos /= previousPos.w;
		float2 pixelVelocity = -(currentPos.xy - previousPos.xy)*0.5;
		
		pixelVelocity/=$positionToViewTexture.zw;
				
		pixelVelocity*=2;
				
		float4 currentPixel = $(rendering/BufferIn).Sample( $linearClamp, UV );

		float4 pixelInput = currentPixel * 2.0;
		pixelInput += $(rendering/BufferIn).Sample( $linearClamp, UV + $positionToViewTexture.zw * float2( $(shadowWalk/BlurSize).x,  $(shadowWalk/BlurSize).x) );
		pixelInput += $(rendering/BufferIn).Sample( $linearClamp, UV + $positionToViewTexture.zw * float2(-$(shadowWalk/BlurSize).x, -$(shadowWalk/BlurSize).x) );
		pixelInput += $(rendering/BufferIn).Sample( $linearClamp, UV + $positionToViewTexture.zw * float2( $(shadowWalk/BlurSize).x, -$(shadowWalk/BlurSize).x) );
		pixelInput += $(rendering/BufferIn).Sample( $linearClamp, UV + $positionToViewTexture.zw * float2(-$(shadowWalk/BlurSize).x,  $(shadowWalk/BlurSize).x) );
		pixelInput *= $(shadowWalk/EnergyFactor).x / 6.0f;

		const float FlowSpeed		= $(rendering/FlowmapOffset).x;
		const float HalfCycle		= $(rendering/FlowmapOffset).y;
		const float FlowMapOffset0	= $(rendering/FlowmapOffset).z;
		const float FlowMapOffset1	= $(rendering/FlowmapOffset).w;
		
		//Compute UV
		float2 flowmapUV = $(shadowWalk/Tilling).x * UV + $(shadowWalk/FlowMapPanning).xy * $time.xx;
		float2 flowmap = $(rendering/Flowmap).Sample( $bilinearSampler, flowmapUV ).xy;
		
		const float3 RGB_TO_GREYSCALE = float3(0.2989, 0.5870, 0.1140);
		float cycleOffset = 1.0 - dot( currentPixel.xyz, RGB_TO_GREYSCALE );

		// Get the flow vector
		float phase0 = cycleOffset * $(shadowWalk/DistanceCoef).x + FlowMapOffset0;
		float phase1 = cycleOffset * $(shadowWalk/DistanceCoef).x + FlowMapOffset1;

		// Sample normal map.
		float4 flowPixelInput0 = $(rendering/BufferIn).SampleLevel( $linearMirror, UV + (flowmap * phase0+$(shadowWalk/BleedDirection).xy+pixelVelocity) * $positionToViewTexture.zw, 0.0 );
		float4 flowPixelInput1 = $(rendering/BufferIn).SampleLevel( $linearMirror, UV + (flowmap * phase1+$(shadowWalk/BleedDirection).xy+pixelVelocity) * $positionToViewTexture.zw, 0.0 );

		float f = ( abs( HalfCycle - FlowMapOffset0 ) / HalfCycle );

		float4 cAccumulation = lerp( flowPixelInput0, flowPixelInput1, f ) * $(shadowWalk/EnergyFactor).x;

		//Accumulate
		//@sv_target = min(max( pixelInput, cAccumulation ), 0.3);
		@sv_target = max( pixelInput, cAccumulation );
	}
}