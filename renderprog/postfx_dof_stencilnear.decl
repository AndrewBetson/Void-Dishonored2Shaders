{
	newstyle

	state {
		depthEnable	0
		depthfunc	ALWAYS
		cull none
	}

	options {
		forcePixelShader 1
	}

	hlsl_prefix {
		#include <dof>
	}

	hlsl_vp_main {
		@sv_position = float4( float3($vertex_position.xyz), 1 );
		@texcoord = $vertex_texcoord;
	}

	hlsl_fp_main {
		float depth = $(PostFX/DOF/dofBlurMap).SampleLevel( $bilinearClamp, $texcoord, 0.0f ).r;

		if(depth <= dofMaskThreshold)
		{
		#ifdef PC_MANTLE
			clip( $alwaysOne - 2 ); /// ugly workaround. Mantle pipeline creation fail in this context with only the discard....
		#else
			discard;
		#endif
		}
	}
}