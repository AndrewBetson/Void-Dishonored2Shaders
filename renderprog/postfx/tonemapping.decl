// {
// #if $(PostFX/ToneMapping/type) != 0
// 	color = $(PostFX/ToneMapping/exposure) * $(PostFX/Luminance/texDownsampledHDR).SampleLevel( $linearClamp, UV, 4.0 ).xyz;
// //	color.xy = UV;
// #else
// 	color = $(PostFX/Luminance/texDownsampledHDR).SampleLevel( $linearClamp, UV, 0.0 ).xyz;
// #endif
// 	color = 1.01 * $(PostFX/Bloom/texBloom).SampleLevel( $linearClamp, UV, 0.0 ).xyz;
// }

if ( !$alwaysOne )
{
	float3	UVW = float3( UV, 0.0 + 0.5 * (1.0 + sin( $time.x ) ) );

//color = $(atm/sky/precompute/texTransmittance).SampleLevel( $linearClamp, UV, 0.0 ).xyz; 
// color = $(atm/sky/precompute/texIrradianceDelta).SampleLevel( $linearClamp, UV, 0.0 ).xyz; 
//color = 10.0 * $(atm/sky/precompute/texScatteringDelta_Rayleigh).SampleLevel( $linearClamp, UVW, 0.0 ).xyz; 
// color = 2.0 * $(atm/sky/precompute/texScatteringDelta_Mie).SampleLevel( $linearClamp, UVW, 0.0 ).xyz; 
// color = $(atm/sky/precompute/texIrradiance).SampleLevel( $linearClamp, UV, 0.0 ).xyz; 
//color = 1000.0 * $(atm/sky/precompute/texScatteringDelta).SampleLevel( $linearClamp, UVW, 0.0 );

// Directional tables (only irradiance is available)
//color = $(atm/sky/texTransmittance).SampleLevel( $linearClamp, UVW, 0.0 ).xyz;
//color = 4.0 * $(atm/sky/texIrradiance).SampleLevel( $linearClamp, UVW, 0.0 ).xyz;
//color = 1.0 * $(atm/sky/texScattering).SampleLevel( $linearClamp, UVW, 0.0 ).xyz;

// Final useable tables
color = $(atm/sky/precompute/texTransmittance).SampleLevel( $linearClamp, UV, 0.0 ).xyz; 
color = 10.0 * $(atm/sky/texIrradiance).SampleLevel( $linearClamp, UVW, 0.0 ).xyz;
//color = $(atm/sky/precompute/texScattering).SampleLevel( $linearClamp, UVW, 0.0 ).xyz; 

// Env map
//color = $(atm/sky/texEnvMap).SampleLevel( $linearClamp, UVW.xy, 0.0 ).xyz;


// color += 0.1 * UVW;


// // uint3	Texel = UVW * float3( 256, 128, 32 );
// // 
// // // Retrieve the 3 cosines for the current slice
// // float	AltitudeKm, CosThetaView, CosThetaSun, CosGamma;
// // GetSliceData( Texel, AltitudeKm, CosThetaView, CosThetaSun, CosGamma );
// // 
// // color = abs(CosThetaSun);
// // color = CosThetaView * (CosThetaView > 0.0 ? float3( 1, 0, 0 ) : float3( 0, 0, -1 ));
// // color = 0.5 + 0.5 * CosGamma;
// // color = AltitudeKm / 60.0;
// 
// 
// 
// 
// if ( UVW.x > 0.999 )
// 	color = float3( UVW.z, 0, 0 );

}

*/

		// ===========================================================		
		@sv_target.xyz = color;
		@sv_target.w = 1;

#endif // !$isShadow && !$isZPrePass && !$isOutline && !$isMasking && !$(tool/unlit)
	}
}