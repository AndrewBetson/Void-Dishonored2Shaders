{
	newstyle
	options {
		NUMTHREADX 8
		NUMTHREADY 8
		NUMTHREADZ 1
		isAsyncCompute 1
	}

	hlsl_prefix {
		#include <PostFX/DWAO/blurCommon>
	}
	hlsl_cp_main {	
		int2	position = int2( $sv_dispatchThreadID.xy );	// Pixel position
		if ( all( position < $(DWAO/bufferSize) ) ) {
			const float		depthThreshold	= $(DWAO/Params0).z;
			float4 values = Blur( position, int2( 0, 1 ), depthThreshold );
			@(DWAO/AOBuffer_UAV)[position] = float4( 1.0 - values.x, values.y, values.zw );
		}
	}
}