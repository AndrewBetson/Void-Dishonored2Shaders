{
	newstyle
	hlsl_prefix {

#ifndef COLORIMETRY_INCLUDED
#define COLORIMETRY_INCLUDED

		///////////////////////////////////////////////////////////////////////////////////////////////
		// ARKANE_BEGIN: bmayaux (2013-10-16) Color Helpers
		static const float3	LUMINANCE = float3( 0.2126, 0.7152, 0.0722 );	// D65 Illuminant and 2° observer (sRGB white point) (cf. http://wiki.patapom.com/index.php/Colorimetry)
																			// Y = dot( RGB, LUMINANCE )

		// All transforms are stolen from http://wiki.nuaj.net/index.php?title=Color_Transforms which are in turn stolen from appropriate sources

		// Conversions sRGB RGB <=> CIE XYZ using D65 illuminant (sRGB white point)
		float3	RGB2XYZ( float3 _RGB ) {
			return float3(	dot( _RGB, float3( 0.4124, 0.3576, 0.1805 ) ),
							dot( _RGB, float3( 0.2126, 0.7152, 0.0722 ) ),		// <= Y component is the LUMINANCE defined above
							dot( _RGB, float3( 0.0193, 0.1192, 0.9505 ) ) );
		}
		
		float3	XYZ2RGB( float3 _XYZ ) {
			return float3(	dot( _XYZ, float3(  3.2406, -1.5372, -0.4986 ) ),
							dot( _XYZ, float3( -0.9689,  1.8758,  0.0415 ) ),
							dot( _XYZ, float3(  0.0557, -0.2040,  1.0570 ) ) );
		}

		// Conversions CIE XYZ <=> CIE xyY (xy = chromaticities, Y = luminance)
		// Y = Y
		// x = X / ( X + Y + Z )
		// y = Y / ( X + Y + Z )
		float3	XYZ2xyY( float3 _XYZ ) {
			float3	XYZ = max( 1e-3, _XYZ );
			float3	xyY;
			xyY.z  = XYZ.y;
			xyY.xy = XYZ.xy / (XYZ.x + XYZ.y + XYZ.z);

			return xyY;
		}

		// X = x * ( Y / y )
		// Y = Y
		// Z = ( 1 - x - y ) * ( Y / y )
		float3	xyY2XYZ( float3 _xyY ) {
			float	Y_over_y = _xyY.z / _xyY.y;
			
			float3	XYZ;
			XYZ.x = _xyY.x * Y_over_y;
			XYZ.y = _xyY.z; 
			XYZ.z = (1.0 - _xyY.x - _xyY.y) * Y_over_y;  
		
			return XYZ;
		}

		// Conversions sRGB RGB <=> CIE xyY
		// Simply re-using the above
		float3	RGB2xyY( float3 _RGB ) {
			return XYZ2xyY( RGB2XYZ( _RGB ) );
		}

		float3	xyY2RGB( float3 _xyY ) {
			return XYZ2RGB( xyY2XYZ( _xyY ) );
		}

		// Conversions RGB <=> HSV (cf. http://wiki.nuaj.net/index.php?title=Color_Transforms#RGB_.2F_HSV)
		// HSV stands for Hue, Saturation, Value where Value is the MAX of (R,G,B) (cf. http://en.wikipedia.org/wiki/HSL_and_HSV)
		// It's supposedly the same as the HSB color picker used in Photoshop...
		//
		// Returns HSV in [0,1]
		// Warning: Hue is NOT in [0,6] as given by wikipedia!
		//
		float3	RGB2HSV( float3 _RGB ) {
			float3	HSV;
			float	Max = max( max( _RGB.x, _RGB.y ), _RGB.z );

			if ( Max <= 0.0001 ) {
				HSV = float3( 0, 0, 0 );
			} else {
				float	Min = min( min( _RGB.x, _RGB.y ), _RGB.z );
				float	Delta = Max - Min;

				HSV.z = Max;				// Value is simply the max...
				HSV.y = Delta / Max;

				float	InvDelta = 1.0 / max( 1e-4, Delta );

				float3	DeltaRGB = (0.5 * Delta + (1.0 / 6.0) * (Max - _RGB)) * InvDelta;	// ((Max-RGB)/6 + (Max-Min)/2) / Max

				// This is the "optimized" version of the following code:
				//	if      ( var_R == var_Max ) H = del_B - del_G
				//	else if ( var_G == var_Max ) H = ( 1 / 3 ) + del_R - del_B
				//	else if ( var_B == var_Max ) H = ( 2 / 3 ) + del_G - del_R
				//	
				float	IsNotRed = saturate( 1e3 * abs( _RGB.x - Max ) );	// 1 if Red is NOT the max of RGB
				float	IsNotGreen = saturate( 1e3 * abs( _RGB.y - Max ) );	// 1 if Green is NOT the max of RGB
				HSV.x = lerp( DeltaRGB.z - DeltaRGB.y, lerp( (1.0 / 3.0) + DeltaRGB.x - DeltaRGB.z, (2.0 / 3.0) + DeltaRGB.y - DeltaRGB.x, IsNotGreen ), IsNotRed );
				HSV.x = frac( HSV.x );	// Ensure [0,1[
			}
			return HSV;
		}

		// Warning: _HSV.y and _HSV.z must be in [0,1]!
		//			_HSV.x can loop though (but is in the [0,1] range, not [0,6] as given by wikipedia!)
		float3	HSV2RGB( float3 _HSV ) {
			float3	RGB = float3(	saturate( 3.0 * abs( 2.0 * frac(_HSV.x) - 1.0 ) - 1.0 ),
									saturate( 3.0 * abs( 2.0 * frac(_HSV.x + (2.0 / 3.0)) - 1.0 ) - 1.0 ),
									saturate( 3.0 * abs( 2.0 * frac(_HSV.x + (1.0 / 3.0)) - 1.0 ) - 1.0 )
								);

			return _HSV.z*(1.0-_HSV.y) + (_HSV.z * _HSV.y) * RGB;	// V(1-S) + VS * RGB
		}

		// Conversions RGB <=> HSL (cf. http://wiki.nuaj.net/index.php?title=Color_Transforms#RGB_.2F_HSL)
		// HSL stands for Hue, Saturation, Lightness (cf. http://en.wikipedia.org/wiki/HSL_and_HSV)
		//
		// Returns HSV in [0,1]
		// Warning: Hue is NOT in [0,6] as given by wikipedia!
		//
		float3	RGB2HSL( float3 _RGB ) {
			float3	HSL;
			float	Min = min( min( _RGB.x, _RGB.y ), _RGB.z );
			float	Max = max( max( _RGB.x, _RGB.y ), _RGB.z );
			float	Delta = Max - Min;

			HSL.z = 0.5 * (Max + Min);	// Lightness is the average
			HSL.y = Delta / (1.0 - abs( 2.0 * HSL.z - 1.0 ));

			float	InvDelta = 1.0 / max( 1e-4, Delta );

			float3	DeltaRGB = (0.5 * Delta + (1.0 / 6.0) * (Max - _RGB)) * InvDelta;	// ((Max-RGB)/6 + (Max-Min)/2) / Max

			// This is the "optimized" version of the following code:
			//	if      ( var_R == var_Max ) H = del_B - del_G
			//	else if ( var_G == var_Max ) H = ( 1 / 3 ) + del_R - del_B
			//	else if ( var_B == var_Max ) H = ( 2 / 3 ) + del_G - del_R
			//	
			float	IsNotRed = saturate( 1e3 * abs( _RGB.x - Max ) );	// 1 if Red is NOT the max of RGB
			float	IsNotGreen = saturate( 1e3 * abs( _RGB.y - Max ) );	// 1 if Green is NOT the max of RGB
			HSL.x = lerp( DeltaRGB.z - DeltaRGB.y, lerp( (1.0 / 3.0) + DeltaRGB.x - DeltaRGB.z, (2.0 / 3.0) + DeltaRGB.y - DeltaRGB.x, IsNotGreen ), IsNotRed );
			HSL.x = frac( HSL.x );	// Ensure [0,1[

			return HSL;
		}

		// Warning: _HSL.y and _HSL.z must be in [0,1]!
		//			_HSL.x can loop though (but is in the [0,1] range, not [0,6] as given by wikipedia!)
		float3	HSL2RGB( float3 _HSL ) {
			float3	RGB = float3(	saturate( 3.0 * abs( 2.0 * frac(_HSL.x) - 1.0 ) - 1.0 ),
									saturate( 3.0 * abs( 2.0 * frac(_HSL.x + (2.0 / 3.0)) - 1.0 ) - 1.0 ),
									saturate( 3.0 * abs( 2.0 * frac(_HSL.x + (1.0 / 3.0)) - 1.0 ) - 1.0 )
								);

			float	C = _HSL.y * (1.0 - abs( 2.0 * _HSL.z - 1.0 ));
			return (_HSL.z-0.5*C) + C * RGB;	// L-0.5*C + C * RGB
		}
		// ARKANE_END: bmayaux (2013-10-16) /Color Helpers
		
		// Converts from RGB to YCoCg
		// If RGB is in [0,max] then Y is in [0,max] and (Co,Cg) are in [-max,+max]  (WARNING! Not the same interval as the wikipedia page where (Co,Cg) are in [-max/2, max/2])
		float3 RGB2YCoCg( float3 _rgb ) {
			float	Co = _rgb.r - _rgb.b;
			float	t = _rgb.b + Co * 0.5;
			float	Cg = _rgb.g - t;
			float	Y = t + Cg * 0.5;
			return float3( Y, Co, Cg );
		}

		float3 YCoCg2RGB( float3 _YCoCg ) {
			float	t = _YCoCg.x - _YCoCg.z * 0.5;
			float	G = _YCoCg.z + t;
			float	B = t - _YCoCg.y * 0.5;
			float	R = _YCoCg.y + B;
			return float3(R, G, B);
		}
		// bmayaux (2016-08-27) Used for multiple (Co,Cg) couples using a single common luminance value
		float3 YCoCg2RGB( float _Y, float2 _CoCg ) {
			float	t = _Y - _CoCg.y * 0.5;
			float	G = _CoCg.y + t;
			float	B = t - _CoCg.x * 0.5;
			float	R = _CoCg.x + B;
			return float3(R, G, B);
		}
		// Funky saturation formula (source???)
		float3	ColorSaturate( float3 _color, float _amount ) {
			return saturate( _color.rgb * (1.0 + _amount*2.0) - (_color.gbr + _color.brg) * _amount );
		}
		
		// Simple desaturation, keeping the same luminance
		float3	ColorDesaturate( float3 _color, float _amount ) {
			float	luminance = dot( _color, LUMINANCE );
			float3	Ctint = luminance > 0.0 ? _color / luminance : 1.0;	// normalize luminance to isolate hue+sat
			return luminance * lerp( 1.0, Ctint, _amount );
		}

		// Computes the color to use for the sheen effect
		//	_color, the original diffuse albedo
		//	_sheen, the sheen effect in [-1,+1]
		//	 • -1 will return a completely desaturated color
		//	 •  0 (default) will return the unmodified original color
		//	 • +1 will return a completely saturated color
		//
		float3	ComputeSheenColor( float3 _color, float _sheen ) {
			float	amountDeSat = saturate( _sheen + 1.0 ) * 0.5 + 0.5;
			float	amountSat =  saturate( _sheen );
			float3	unSaturatedAlbedo = lerp( 1.0 - amountDeSat, _color, amountDeSat );
			float3	saturatedAlbedo = saturate( (1.0 + amountSat) * ColorSaturate( _color, amountSat ) );
			float3	sheenColor = lerp( unSaturatedAlbedo, saturatedAlbedo, _sheen * 0.5 + 0.5 );	// A sheen of -1 will show desaturated color, a sheen of +1 will show fully saturated color
			return sheenColor;
		}


		///////////////////////////////////////////////////////////////////////////////////////////////
		// ARKANE: bmayaux (2014-05-12) Color grading
		static const uint	COLOR_CUBE_POT = 5;			// Color grading color cubes are 32x32x32 (don't forget to also change COLOR_CUBE_SIZE in RenderView.h!)
		static const uint	COLOR_CUBE_SIZE = 1 << COLOR_CUBE_POT;

		#define	INV_COLOR_CUBE_SIZE		(1.0 / COLOR_CUBE_SIZE)

#endif // #ifndef COLORIMETRY_INCLUDED
	}
}