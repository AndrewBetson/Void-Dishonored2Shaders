{
	newstyle
	parms {
		stageSort	sortCoverage
	}
	state {
		depthfunc	ALWAYS
		depthWrite 0
		depthEnable	0
		blend		SRC_ALPHA ONE_MINUS_SRC_ALPHA
	}
	
	hlsl_prefix {
		#include <testImage/common>
	}
	
	hlsl_vp_main {
		@sv_position.x = dot( float4($vertex_position.xyz,1), $mvpMatrixX ) * $testImageFlip.x;
		@sv_position.y = dot( float4($vertex_position.xyz,1), $mvpMatrixY ) * $testImageFlip.y;
		@sv_position.z = dot( float4($vertex_position.xyz,1), $mvpMatrixZ );
		@sv_position.w = dot( float4($vertex_position.xyz,1), $mvpMatrixW );
		
		@(legacy_texcoord) = $(vertex_texcoord).xyxy;

	}
	hlsl_fp_main {
#if 1
		if ( ($testImageIntParms0.y & 2) )
		{	// Asuint version
			float4	color = $textureMap.SampleLevel( $pointClamp, $legacy_texcoord.xy, $testImageLODAndSlice.x ); //ARKANE: jvirga (2013-12-13)
			@sv_target = TransformColorAsUint( $sv_position.xy, asuint( color ) );
		}
		else
		{
			float4	color = $textureMap.SampleLevel( $linearClamp, $legacy_texcoord.xy, $testImageLODAndSlice.x ); //ARKANE: jvirga (2013-12-13)
			@sv_target = TransformColor( $sv_position.xy, color );
		}
		@sv_target.w = $testImageAlpha.x;
#else
		half4 YCoCg = tex2Dlod( $textureMap, tc );
		YCoCg.z = ( YCoCg.z * (255.0/8.0) ) + 1.0;
		YCoCg.z = 1.0 / YCoCg.z;
		YCoCg.xy *= YCoCg.z;
		result.color.x = dot4( YCoCg, matrixCoCg1YtoRGB1X );
		result.color.y = dot4( YCoCg, matrixCoCg1YtoRGB1Y );
		result.color.z = dot4( YCoCg, matrixCoCg1YtoRGB1Z );
		result.color.w = $testImageAlpha.x;
#endif
	}
}