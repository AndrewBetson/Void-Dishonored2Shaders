{
	newstyle

	state {
		blend		SRC_ALPHA	ONE_MINUS_SRC_ALPHA
		depthWrite	0
		depthEnable	1
		depthfunc	ALWAYS
		cull none
	}

	hlsl_prefix {
		#include <vertex>
		#include <dof>
	}

	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord = $vertex_texcoord;
	}
	hlsl_fp_main {
		float sina, cosa;
		float compressedValues = $(PostFX/DOF/refractionMap).SampleLevel( $bilinearClamp, $texcoord, 0.0f ).y;
		float2 rawBlurSize = DecompressGlassDistortion(compressedValues);
		float blurSize = rawBlurSize.y;

		float doBlur = (blurSize > 0.0) ? 1.0 : 0.0;
		float2 refraction = 0.0;

		if( blurSize == 1.0 ) {
			float angle = rawBlurSize.x;
			sincos( angle, sina, cosa );
			float2 offsets = float2( cosa, sina ) * GetRefractionOffset( ) * 2.0;
			refraction = offsets * $positionToViewTexture.zw;
		}

		float  dofAlpha = $(PostFX/DOF/dofNearAlphaMap).SampleLevel( $bilinearClamp, $texcoord + refraction, 0.0f );
		float alpha = saturate( dofAlpha + doBlur );
		clip( alpha - 1.0/255.0 );

		float3 dofRgb = $(PostFX/DOF/blurredMap).SampleLevel( $bilinearClamp, $texcoord + refraction, 0.0f ).rgb;
		@sv_target = float4(dofRgb, alpha );
	}
}