{
	newstyle
	options {	
		NUMTHREADX 16
		NUMTHREADY 16
		NUMTHREADZ 1
	}
	
	hlsl_prefix {		
	}

	hlsl_cp_main {
		uint2 DTid = $sv_dispatchThreadID.xy;
		
		float foam = @(FFTWaves/FoamMask)[ DTid ];
		
		if( $(FFTWaves/FFTDisplacement)[ DTid ].z > $(FFTWaves/FoamThreshold).x )
		{
			foam += $(FFTWaves/FoamSpawnRate).x * $localTime.y;
			foam = min( foam, 1.0f );
		}

		foam -= foam * $(FFTWaves/FoamDecayRate).x * $localTime.y;
		foam = max( foam, 0.0f );
		
		@(FFTWaves/FoamMask)[ DTid ] = foam;
	}
}