{
	newstyle

	options {
	}
	parms {
	}
	state {
		depthwrite	1
		cull		none
	}
	
	hlsl_prefix {
		#include <vertex>
		#include <indirectLighting/precompute/common>
		#include <PostFX/Luminance/common>

		static const float	PROBE_RADIUS = 0.4;
	}
	
	hlsl_vp_main {

		float3	ProbePosition = $(indirectLighting/debug/probeWorldPosition);

		// Compute face-cam plane normal
		float3	PlaneNormal = $wsCamPos - ProbePosition;
		float	Distance2Camera = length( PlaneNormal );
		PlaneNormal /= Distance2Camera;

		// Rebuild tangent space
		float3	PlaneTangent = cross( float3( 0, 0, 1 ), PlaneNormal );
		float3	PlaneBiTangent;
		float	L = length( PlaneTangent );
		if ( L > 1e-6 ) {
			PlaneTangent /= L;
			PlaneBiTangent = cross( PlaneNormal, PlaneTangent );
		} else {
			// Arbitrary basis
			PlaneTangent = float3( 1, 0, 0 );
			PlaneBiTangent = float3( 0, 1, 0 );
		}

		// Expand unit quad from [-1,+1] to an actual world space quad whose size depends on the distance with the probe
		float4	WorldPosition = float4( ProbePosition + PROBE_RADIUS * ($vertex_position.x * PlaneTangent + $vertex_position.y * PlaneBiTangent), 1.0 );

		float4	ProjPosition = mul( $viewProjectionMatrix, WorldPosition );

		@sv_position = ProjPosition;
		@wsPosition = WorldPosition.xyz;
		@wsNormal = PlaneNormal;
		@texcoord = $vertex_position.xy;
	}

	hlsl_fp_main {
		float2	UV = $texcoord;
		float	SqRadius = dot( UV, UV );

//		clip( 1.0 - SqRadius );	// Clip pixels out of the sphere
		bool	Invalid = $(indirectLighting/debug/renderParms).w & 1;
		uint	SelectedState = ($(indirectLighting/debug/renderParms).w >> 1) & 3;
		float	MaxRadius = Invalid ? 0.95 : (SelectedState != 0 ? 0.96 : 1.0);
		if ( SqRadius > MaxRadius*MaxRadius ) {
			clip( 1.0-SqRadius );

			$(PostFX/Luminance/autoExposure_t) Adaptation = ReadAutoExposureParameters();
			float	ExposureCompensation = 1.0 / Adaptation.EngineLuminanceFactor;

			if ( SelectedState != 0 ) {
				// Represent a selected probe by a red or orange circle depending whether the probe is selected in the current map or another map
				@sv_target = ExposureCompensation * (SelectedState == 1 ? float4( 1.0, 0, 0, 1 ) : float4( 1.0, 0.8, 0, 1 ));

// 					float	Z = PROBE_RADIUS * sqrt( saturate( 1.0 - SqRadius / MaxRadius ) );
// 					float4	pPosition = mul( $viewProjectionMatrix, float4( $wsPosition + Z * $wsNormal, 1 ) );
// 					@sv_depth = pPosition.z / pPosition.w;
				@sv_depth = 1.0;
				return;
			} else if ( Invalid ) {
				// Represent an invalid probe by displaying a rotating dashed red circle that will also override the Z so it shows even when behind geometry
				float	angle = (-0.1*$time.x + atan2( UV.y, UV.x ) * INVTWOPI) * 20.0;
				if ( step( 0.5, frac( angle ) ) ) {
					@sv_target = ExposureCompensation * float4( 1.0, 0, 0, 1 );

					float4	pPosition = mul( $viewProjectionMatrix, float4( $wsPosition.xyz, 1 ) );
					@sv_depth = 1.0;//pPosition.z / pPosition.w;
					return;
				}
			}
		}

		float	Z = PROBE_RADIUS * sqrt( saturate( 1.0 - SqRadius / MaxRadius ) );

		float3	WorldPosition = $wsPosition;
				WorldPosition += Z * $wsNormal;	// Offset world position on the plane along the normal

		// Recompute sphere normal
		float3	WorldNormal = normalize( WorldPosition - $(indirectLighting/debug/probeWorldPosition) );

		// Sample cube map either in the direction of the normal or the reflected direction
		uint	SHProbeIndex = $(indirectLighting/debug/renderParms).x;
		uint	IBLProbeIndex = $(indirectLighting/debug/renderParms).y;
		uint	RenderType = $(indirectLighting/debug/renderParms).z;

		const float	MIP_LEVEL = 0.0;

		float3	Color = 0.0;
		if ( RenderType == 2 ) {
			// Direct view
			Color = $(IBL/texCubeMapArray).SampleLevel( $trilinearSampler, float4( WorldNormal, IBLProbeIndex ), MIP_LEVEL ).xyz;
		} else if ( RenderType == 1 ) {
			// Reflection
			float3	View = normalize( WorldPosition - $wsCamPos );

			float3	Reflection = reflect( View, WorldNormal );
			Color = $(IBL/texCubeMapArray).SampleLevel( $trilinearSampler, float4( Reflection, IBLProbeIndex ), MIP_LEVEL ).xyz;
		} else {
			// Or render SH for standard IL probes...
			$(indirectLighting/SH3)	Probe = LoadProbeSH( SHProbeIndex );

			if ( RenderType == 3 )
				Color = EvaluateSHIrradiance( WorldNormal, Probe.SH );
			else if ( RenderType == 4 )
				Color = EvaluateSH( WorldNormal, Probe.SH );

			#ifndef __PSSL__
				else if ( RenderType == 5 )
				{	// Render the environment distances
					float	Phi = atan2( WorldNormal.x, WorldNormal.y );
//					float	Theta = safeAcos( WorldNormal.z );
					float	CosTheta = WorldNormal.z;

					uint	ORDER = 16;
//					uint	ORDER = 4;
					uint	COEFFS_COUNT = ORDER*ORDER;

					[loop]
					[fastopt]
					float	Distance = 0.0;
					for ( uint i=0; i < COEFFS_COUNT; i++ ) {
//					for ( uint i=0; i < 16; i++ ) {
						int	l = int( floor( sqrt( i ) ) );
						int	m = int(i) - l*(l+1);
						Distance += GetSHCoeff( l, m, Phi, CosTheta ) * $(indirectLighting/debug/bufferSHEnvironmentDistance)[i];
					}

					float	MaxDistance = 20.0;	// asfloat($(indirectLighting/debug/renderParms).w);
					Color = Distance / MaxDistance;
				}
			#endif // #ifndef __PSSL__

			else if ( RenderType == 6 ) {
				// bmayaux (2015-04-16) Render SH occlusion
				float3	SH[9];
				for ( uint i=0; i < 9; i++ ) {
					SH[i] = $(indirectLighting/debug/bufferSHEnvironmentDistance)[i];
				}
				Color = EvaluateSH( WorldNormal, SH );

				// No exposure for this [0,1] ranged value
				$(PostFX/Luminance/autoExposure_t)  Adaptation = ReadAutoExposureParameters();
				Color /= Adaptation.EngineLuminanceFactor;

			} else if ( RenderType == 7 || RenderType == 8 ) {
				// bmayaux (2015-04-23) Render static SH lighting
				float3	SH[9];
				for ( uint i=0; i < 9; i++ ) {
					SH[i].x = $(indirectLighting/debug/bufferSHEnvironmentDistance)[3*i+0];
					SH[i].y = $(indirectLighting/debug/bufferSHEnvironmentDistance)[3*i+1];
					SH[i].z = $(indirectLighting/debug/bufferSHEnvironmentDistance)[3*i+2];
				}
				Color = EvaluateSHIrradiance( WorldNormal, SH );
			} else if ( RenderType == 9 || RenderType == 10 ) {
				// bmayaux (2015-04-23) Render dynamic/dynamic Sun SH lighting
				$(indirectLighting/SH3)	Coeffs;
				if ( RenderType == 9 ) {
					Coeffs = $(indirectLighting/update/bufferProbesSH_Dynamic)[SHProbeIndex];
				} else {
					Coeffs = $(indirectLighting/update/bufferProbesSH_StaticSun)[SHProbeIndex];
				}

				Color = EvaluateSHIrradiance( WorldNormal, Coeffs.SH );
//				Color = EvaluateSH( WorldNormal, Coeffs.SH );

//Color *= FOURPI;

				Color *= RenderType == 10 ? $(atm/sky/sunColorAtGroundLevel) : 1.0;	// Visualizing Sun color?
			}
		}

//		if ( any(isnan(Color)) || any(Color*0.0 != 0.0) ) {
//			Color = float3( 1000, 0, 1000 );
//		}

		@sv_target = float4( RangeCompressColorToR11G11B10( Color ), 0 );

		float4	pPosition = mul( $viewProjectionMatrix, float4( WorldPosition, 1 ) );
		@sv_depth = pPosition.z / pPosition.w;
	}
}