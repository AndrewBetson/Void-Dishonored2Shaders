// 
// 				float3	signs = float3( (exponent & 128U) != 0 ? -1.0 : 1.0, (exponent & 64U) != 0 ? -1.0 : 1.0, (exponent & 32U) != 0 ? -1.0 : 1.0 );
// 				float	power = exp2( int(exponent & 31U) - SH_RGBE_EXPONENT_BIAS );
