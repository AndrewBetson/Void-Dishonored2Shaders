{
	newstyle
	hlsl_prefix {
#ifndef INDIRECT_LIGHTING_INCLUDED
#define INDIRECT_LIGHTING_INCLUDED

		#include <sphericalHarmonics>
		#include <colorimetry>

		// bmayaux (2016-08-25) In order to use less interpolants from VS to PS on PC, we're now packing 4 float3 irradiance values into a single luminance and 8 (Co,Cg) couples stored into 2 float4 interpolants
		// We could use this on consoles as well by packing (Cg,Co) as uint8 that would fit into a single uint2 interpolant + luminance
		void	PackIrradianceYCgCo( float3 _irradiance0, float3 _irradiance1, float3 _irradiance2, float3 _irradiance3, out float _luminance, out float4 _CgCo0, out float4 _CgCo1 ) {
			float3	YCoCg0 = RGB2YCoCg( _irradiance0 );
			float3	YCoCg1 = RGB2YCoCg( _irradiance1 );
			float3	YCoCg2 = RGB2YCoCg( _irradiance2 );
			float3	YCoCg3 = RGB2YCoCg( _irradiance3 );

			// Rescale (Co, Cg) by the Y/(Ymax*Ymax) ratio
			// The Ymax² denominator is there to guarantee (Co,Cg) couples will always be in the [1,+1] interval (so they can easily be packed in a single byte if needed later)
			// Of course, (Co,Cg) couples need to be multiplied by Ymax first on the unpacking side...
			_luminance = max( max( max( YCoCg0.x, YCoCg1.x ), YCoCg2.x ), YCoCg3.x );
			float	factor = 1.0 / max( 1e-4, _luminance*_luminance );
			_CgCo0.xy = YCoCg0.yz * (factor * YCoCg0.x);
			_CgCo0.zw = YCoCg1.yz * (factor * YCoCg1.x);
			_CgCo1.xy = YCoCg2.yz * (factor * YCoCg2.x);
			_CgCo1.zw = YCoCg3.yz * (factor * YCoCg3.x);
		}

		void	UnpackIrradianceYCgCo( float _luminance, float4 _CgCo0, float4 _CgCo1, out float3 _irradiance0, out float3 _irradiance1, out float3 _irradiance2, out float3 _irradiance3 ) {
			// Expand (Co,Cg) from [-1,+1] range back to original [-Y,+Y] range (as explained in packing above)
			_CgCo0 *= _luminance;
			_CgCo1 *= _luminance;

			// Proper unpacking
			_irradiance0 = YCoCg2RGB( _luminance, _CgCo0.xy );
			_irradiance1 = YCoCg2RGB( _luminance, _CgCo0.zw );
			_irradiance2 = YCoCg2RGB( _luminance, _CgCo1.xy );
			_irradiance3 = YCoCg2RGB( _luminance, _CgCo1.zw );
		}

		#if defined(PC)
// 			// bmayaux (2016-09-28) Packing/Unpacking of SH3 structure into RGBE structure
// 			static const int	SH_RGBE_EXPONENT_BIAS = 22;	// This bias allows to encode from 2^-22 to 2^9 which is largely enough to cover our needs
// 															// I measured a maximum of 0.7% relative error on SH coefficients from the "Edge of the World" map where the largest luminance was ~60
// 
// 			uint	PackSH2RGBE( in float3 _SH ) {
// 				// We need to extract 3 sign bits, one for each component
// 				float3	signs = step( 0.0, _SH ) * 2.0 - 1.0;
// 				_SH = abs( _SH );
// 
// 				float	maxRGB = max( max( _SH.x, _SH.y ), _SH.z );
// 				float	sharedExponent = ceil( log2( maxRGB ) );
// 						sharedExponent = clamp( sharedExponent + SH_RGBE_EXPONENT_BIAS, 0, 31 ) - SH_RGBE_EXPONENT_BIAS;
