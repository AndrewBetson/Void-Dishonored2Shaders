// 				_SH.SH[0] = _RGBE.SH0;	// Ambient term is unpacked
// 				_SH.__PADDING = 0.0;	// Don't care but the compiler whines about that :(
// 				[unroll]
// 				for ( uint i=0; i < 8; i++ ) {
