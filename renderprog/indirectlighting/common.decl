		// Reads the information about the 4 probes browsed by the tetrahedron
		$(indirectLighting/tetrahedronInfo_t)	ReadTetrahedronInfo( uint _tetrahedronIndex ) {

			// Retrieve the tetrahedron vertices
			$(indirectLighting/tetrahedron_t)		tetrahderon = $(indirectLighting/bufferTetrahedrons)[_tetrahedronIndex];
			$(indirectLighting/tetrahedronVertex_t)	vertices[4];
			vertices[0] = $(indirectLighting/bufferTetrahedronVertices)[tetrahderon.vertexIndices.x];
			vertices[1] = $(indirectLighting/bufferTetrahedronVertices)[tetrahderon.vertexIndices.y];
			vertices[2] = $(indirectLighting/bufferTetrahedronVertices)[tetrahderon.vertexIndices.z];
			vertices[3] = $(indirectLighting/bufferTetrahedronVertices)[tetrahderon.vertexIndices.w];

			// Fill up the result structure
			$(indirectLighting/tetrahedronInfo_t)	Result;

			Result.wsPositions[0] = vertices[0].wsPosition;
			Result.wsPositions[1] = vertices[1].wsPosition;
			Result.wsPositions[2] = vertices[2].wsPosition;
			Result.wsPositions[3] = vertices[3].wsPosition;

			Result.probeIndices.x = tetrahderon.probeIndices.x & 0xFFFF;
			Result.probeIndices.y = tetrahderon.probeIndices.x >> 16;
			Result.probeIndices.z = tetrahderon.probeIndices.y & 0xFFFF;
			Result.probeIndices.w = tetrahderon.probeIndices.y >> 16;

			Result.probeWeights[0]  = (1.0 / 255.0) * float4(	((vertices[0].probeWeights      ) & 0xFF),
																((vertices[0].probeWeights >>  8) & 0xFF),
																((vertices[0].probeWeights >> 16) & 0xFF),
																((vertices[0].probeWeights >> 24) & 0xFF) );
			Result.probeWeights[1]  = (1.0 / 255.0) * float4(	((vertices[1].probeWeights      ) & 0xFF),
																((vertices[1].probeWeights >>  8) & 0xFF),
																((vertices[1].probeWeights >> 16) & 0xFF),
																((vertices[1].probeWeights >> 24) & 0xFF) );
			Result.probeWeights[2]  = (1.0 / 255.0) * float4(	((vertices[2].probeWeights      ) & 0xFF),
																((vertices[2].probeWeights >>  8) & 0xFF),
																((vertices[2].probeWeights >> 16) & 0xFF),
																((vertices[2].probeWeights >> 24) & 0xFF) );
			Result.probeWeights[3]  = (1.0 / 255.0) * float4(	((vertices[3].probeWeights      ) & 0xFF),
																((vertices[3].probeWeights >>  8) & 0xFF),
																((vertices[3].probeWeights >> 16) & 0xFF),
																((vertices[3].probeWeights >> 24) & 0xFF) );

			return Result;
		}

		// Interpolates the SH coefficients/IBL probe index for a position within a tetrahedron made of 4 probes
		void	InterpolateSH( float4 _barycentrics, $(indirectLighting/tetrahedronInfo_t) _tetrahedronInfos, out float3 _SH[SH_COEFFS_COUNT], out uint _IBLProbeIndex, out float _IBLLuminanceFactor ) {
			// Barycentrics actually interpolate weights here
			float4		Weights = _barycentrics.x * _tetrahedronInfos.probeWeights[0]
								+ _barycentrics.y * _tetrahedronInfos.probeWeights[1]
								+ _barycentrics.z * _tetrahedronInfos.probeWeights[2]
								+ _barycentrics.w * _tetrahedronInfos.probeWeights[3];

			// Read each probe's IBL probe index & luminance factor
			$(indirectLighting/probeInfo_t)	probeInfo[4];
			probeInfo[0] = $(indirectLighting/bufferProbeInfo)[_tetrahedronInfos.probeIndices.x];
			probeInfo[1] = $(indirectLighting/bufferProbeInfo)[_tetrahedronInfos.probeIndices.y];
			probeInfo[2] = $(indirectLighting/bufferProbeInfo)[_tetrahedronInfos.probeIndices.z];
			probeInfo[3] = $(indirectLighting/bufferProbeInfo)[_tetrahedronInfos.probeIndices.w];

			// Determine the IBL to use depending on the strongest weight
			float2	BestWeight =							float2( Weights.x, probeInfo[0].IBLProbeIndex );
					BestWeight = Weights.y > BestWeight.x ? float2( Weights.y, probeInfo[1].IBLProbeIndex ) : BestWeight;
					BestWeight = Weights.z > BestWeight.x ? float2( Weights.z, probeInfo[2].IBLProbeIndex ) : BestWeight;
					BestWeight = Weights.w > BestWeight.x ? float2( Weights.w, probeInfo[3].IBLProbeIndex ) : BestWeight;
			_IBLProbeIndex = uint( BestWeight.y );

			// Compute weighted IBL luminance factor
			float4		IBLLuminanceFactors;
			IBLLuminanceFactors.x = probeInfo[0].IBLLuminanceFactor;
			IBLLuminanceFactors.y = probeInfo[1].IBLLuminanceFactor;
			IBLLuminanceFactors.z = probeInfo[2].IBLLuminanceFactor;
			IBLLuminanceFactors.w = probeInfo[3].IBLLuminanceFactor;

			_IBLLuminanceFactor = max( 0.0001, dot( Weights, IBLLuminanceFactors ) );

			// Only then can we do a weighted sum of the coefficients
			$(indirectLighting/SH3)	Coeffs[4];
			Coeffs[0] = LoadProbeSH( _tetrahedronInfos.probeIndices.x );
			Coeffs[1] = LoadProbeSH( _tetrahedronInfos.probeIndices.y );
			Coeffs[2] = LoadProbeSH( _tetrahedronInfos.probeIndices.z );
			Coeffs[3] = LoadProbeSH( _tetrahedronInfos.probeIndices.w );

			#if defined(PC)	// 9 coefficients on PC
				[unroll]
				for ( uint i=0; i < 9; i++ ) {
					_SH[i] = Weights.x * Coeffs[0].SH[i] + Weights.y * Coeffs[1].SH[i] + Weights.z * Coeffs[2].SH[i] + Weights.w * Coeffs[3].SH[i];
				}
			#else			// Only 4 on consoles
				[unroll]
				for ( uint i=0; i < 4; i++ ) {
					_SH[i] = Weights.x * Coeffs[0].SH[i] + Weights.y * Coeffs[1].SH[i] + Weights.z * Coeffs[2].SH[i] + Weights.w * Coeffs[3].SH[i];
				}
			#endif
		}

		float	DotCross( float3 _V0, float3 _V1, float3 _V2 ) {
			return dot( _V0, cross( _V1, _V2 ) );
		}
		float4	ComputeTetrahedronBarycentrics( float3 _wsPosition, float3 _P[4] ) {
			float3	D = _wsPosition - _P[3];
			float3	V3_0 = _P[0] - _P[3];
			float3	V3_1 = _P[1] - _P[3];
			float3	V3_2 = _P[2] - _P[3];
			float	det = DotCross( V3_0, V3_1, V3_2 );
			float	rcpDeterminant = abs( det ) > 0.0 ? 1.0 / det : 0.0;

			float	barycentric0 = rcpDeterminant * DotCross( D, V3_1, V3_2 );
			float	barycentric1 = rcpDeterminant * DotCross( D, V3_2, V3_0 );
			float	barycentric2 = rcpDeterminant * DotCross( D, V3_0, V3_1 );
			float	barycentric3 = 1.0 - barycentric0 - barycentric1 - barycentric2;

			return float4( barycentric0, barycentric1, barycentric2, barycentric3 );
		}
		void	InterpolateSH( float3 _wsPosition, float3 _wsNormal, $(indirectLighting/tetrahedronInfo_t) _tetrahedronInfos, out float3 _SH[SH_COEFFS_COUNT], out uint _IBLProbeIndex, out float _IBLLuminanceFactor ) {
			// Determine the barycentric coordinates based on the position
			float4	barycentrics = ComputeTetrahedronBarycentrics( _wsPosition, _tetrahedronInfos.wsPositions );
//					barycentrics = saturate( barycentrics );

			//@TODO: Scale barycentrics with normal??

			InterpolateSH( barycentrics, _tetrahedronInfos, _SH, _IBLProbeIndex, _IBLLuminanceFactor );
		}


		///////////////////////////////////////////////////////////////////////////////////////////////
		// Packing/Unpacking of SH coefficients into 4 irradiances values evaluated along 4 principal directions
		// We only pass 4 values to the pixel to avoid using 9 float3 interpolants (or 7 float4 interpolants)
		//

		// Evaluates the irradiance along 4 principal directions, in the manner of Bunnel (slide 25 in http://cgg.mff.cuni.cz/~jaroslav/gicourse2010/giai2010-05-michael_bunnell-slides.pdf)
		// My contribution to the original idea of packing indirect lighting along 3 principal directions is:
		//	> use a 4th, most important direction along the normal (ideally, we should use the bent normal)
		//	> use AO as a measure of cone aperture to blend the estimate direction toward the normal
		//		=> We can see AO as a reduction of FOV and when the FOV narrows down to 0, irradiance can only come from the normal direction anyway
		//	> Also artificially increase the weight of irradiance along the normal direction when AO tends toward 0
		//
		void	PackSHPrincipalDirections( float3 _SH[9], float3 _Tangent, float3 _BiTangent, float3 _Normal, out float3 _Irradiance0, out float3 _Irradiance1, out float3 _Irradiance2, out float3 _Irradiance3 ) {

			// Reflection vectors in tangent space are constant
			// (45° from normal and 180°, -60°, and 60° around normal vector)
			const float3	r0 = float3( 0.7071, 0, 0.7071 );
			const float3	r1 = float3( -0.35355, -0.61237, 0.7071 );
			const float3	r2 = float3( -0.35355, 0.61237, 0.7071 );

			float3	Dir0 = r0.x * _Tangent /*+ r0.y * _BiTangent*/ + r0.z * _Normal;
			float3	Dir1 = r1.x * _Tangent + r1.y * _BiTangent + r1.z * _Normal;
			float3	Dir2 = r2.x * _Tangent + r2.y * _BiTangent + r2.z * _Normal;
			#if $twoSidedLighting
				float3	Dir3 = -_Normal;	// Opposite normal
			#else
				float3	Dir3 = _Normal;		// Plain normal
			#endif

			_Irradiance0 = EvaluateSHIrradiance( Dir0, _SH );
			_Irradiance1 = EvaluateSHIrradiance( Dir1, _SH );
			_Irradiance2 = EvaluateSHIrradiance( Dir2, _SH );
			_Irradiance3 = EvaluateSHIrradiance( Dir3, _SH );
		}

		#if !$twoSidedLighting

			// Uses 3 principal directions to encode the irradiance, the 4th direction is the radiance coming in normal direction
			float3	UnPackSHPrincipalDirections( float3 _Direction, float3 _Tangent, float3 _BiTangent, float3 _Normal, float3 _Irradiance[4], float _AO ) {

// bmayaux (2015-05-01) This line seems to yield problems with double-sided surfaces because the pixel and geometric normals are in opposite directions (I think)
// • I first swapped the geometric normal's direction in the pixel.inc so we always read it correctly
// • Then I restored the lerp but used a "safe normalization" to avoid divide by 0
//				_Direction = normalize( Slerp( _Normal, _Direction, _AO ) );	// Blend more and more toward normal when AO decreases

				_Direction = lerp( _Normal, _Direction, _AO );	// Blend more and more toward normal when AO decreases
				float	dirLength = length(_Direction);
				_Direction *= dirLength > 1e-6 ? 1.0 / dirLength : 1.0;


// bmayaux (2016-06-24) We're finally getting rid of these debug variables
// 				#if defined(PC) && !defined( RETAIL )
// 				// bmayaux (2015-12-03) Simplified, we're not using the 4th component anymore
// //				#if 1
// 				if ( $DEBUG_ILFactor.x >= 0.5 ) {
// 
// 					// Reflection vectors in tangent space are constant
// 					// (45° from normal and 180°, -60°, and 60° around normal vector)
// 					const float3	r0 = float3( 0.7071, 0, 0.7071 );
// 					const float3	r1 = float3( -0.35355, -0.61237, 0.7071 );
// 					const float3	r2 = float3( -0.35355, 0.61237, 0.7071 );
// 
// 					float3	tsDirection = float3( dot( _Direction, _Tangent ), dot( _Direction, _BiTangent ), dot( _Direction, _Normal ) );
// 
// //					float4	D = saturate( float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z ) );	// Saturate is wrong!
// 					float4	D = (2.0*$DEBUG_ILFactor.x-1.0) * float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z );	// Use debug value as a coefficient so we can adjust the gain
// 
// 							D.w *= 1e-6;	// To avoid _Irradiance[3] being stripped by the compiler so we don't have interpolator mismatches
// 
// 					float3	Irradiance = D.x * _Irradiance[0] + D.y * _Irradiance[1] + D.z * _Irradiance[2] + D.w * _Irradiance[3];
// 					return _AO * Irradiance;
// 
// 				} else {
// 
// 					// Reflection vectors in tangent space are constant
// 					// (45° from normal and 180°, -60°, and 60° around normal vector)
// 					const float3	r0 = float3( 0.7071, 0, 0.7071 );
// 					const float3	r1 = float3( -0.35355, -0.61237, 0.7071 );
// 					const float3	r2 = float3( -0.35355, 0.61237, 0.7071 );
// 
// 					float3	tsDirection = float3( dot( _Direction, _Tangent ), dot( _Direction, _BiTangent ), dot( _Direction, _Normal ) );
// 
// //					float4	D = float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z );
// 					float4	D = $DEBUG_ILFactor.x < 0.25	? float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z )
// 															: saturate( float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z ) );
// 
//  							D.w *= lerp( 4.0, 1.0, _AO );	// Artificially increase weight of normal direction based on AO
// 
// 					// Normalize weights
// 					float	SumWeights = D.x + D.y + D.z + D.w;
// 					D *= 1.0 / max( 1.0, SumWeights );
// 
// 					float3	Irradiance = D.x * _Irradiance[0] + D.y * _Irradiance[1] + D.z * _Irradiance[2] + D.w * _Irradiance[3];
// 					return _AO * Irradiance;
// 
// 				} //#endif
// 
// 				#else // #if defined(PC) && !defined( RETAIL )

					// Reflection vectors in tangent space are constant
					// (45° from normal and 180°, -60°, and 60° around normal vector)
					const float3	r0 = float3( 0.7071, 0, 0.7071 );
					const float3	r1 = float3( -0.35355, -0.61237, 0.7071 );
					const float3	r2 = float3( -0.35355, 0.61237, 0.7071 );

					float3	tsDirection = float3( dot( _Direction, _Tangent ), dot( _Direction, _BiTangent ), dot( _Direction, _Normal ) );

					float4	D = float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ), tsDirection.z );	// Use debug value as a coefficient so we can adjust the gain

							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
							D *= 0.5;
							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
							// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS

							D.w *= 1e-6;	// To avoid _Irradiance[3] being stripped by the compiler so we don't have interpolator mismatches

					float3	Irradiance = D.x * _Irradiance[0] + D.y * _Irradiance[1] + D.z * _Irradiance[2] + D.w * _Irradiance[3];
					return _AO * Irradiance;

// 				#endif // #if defined(PC) && !defined( RETAIL )
			}

		#else	// #if $twoSidedLighting

			// Same as above except it uses the 4th irradiance component to encode irradiance coming from the direction opposite to the surface's normal direction
			float3	UnPackSHPrincipalDirections( float3 _Direction, float3 _Tangent, float3 _BiTangent, float3 _Normal, float3 _Irradiance[4], float _AO ) {

				// Reflection vectors in tangent space are constant
				// (45° from normal and 180°, -60°, and 60° around normal vector)
				const float3	r0 = float3( 0.7071, 0, 0.7071 );
				const float3	r1 = float3( -0.35355, -0.61237, 0.7071 );
				const float3	r2 = float3( -0.35355, 0.61237, 0.7071 );

				float3	tsDirection = float3( dot( _Direction, _Tangent ), dot( _Direction, _BiTangent ), dot( _Direction, _Normal ) );

				float4	D = saturate(	float4( dot( tsDirection, r0 ), dot( tsDirection, r1 ), dot( tsDirection, r2 ),
												-tsDirection.z )	// 4th component along -Normal to account for backlighting
												);

// bmayaux (2016-06-24) We're finally getting rid of these debug variables
// 				#if defined(PC) && !defined( RETAIL )
// 					D *= $DEBUG_ILFactor.x >= 0.5 ? saturate( 2.0*$DEBUG_ILFactor.x-1.0 ) : 0.5;
// 				#else
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
					D *= 0.5;
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
					// (2015-12-06) HARDCODED TO MATCH CURRENT LIGHTING SETTINGS
// 				#endif

// 				// Normalize weights
// 				float	SumWeights = D.x + D.y + D.z + D.w;
// 				D *= 1.0 / max( 1.0, SumWeights );

				float3	Irradiance = D.x * _Irradiance[0] + D.y * _Irradiance[1] + D.z * _Irradiance[2] + D.w * _Irradiance[3];
				return _AO * Irradiance;
			}

		#endif

#endif	// #ifndef INDIRECT_LIGHTING_INCLUDED
	}
}