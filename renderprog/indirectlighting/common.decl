// 				// Pack into a uint
// 				uint3	RGB = uint3( 255.0 * reducedRGB );
// 				uint	exponent = uint(SH_RGBE_EXPONENT_BIAS + sharedExponent)	// 5 bits exponent from -22 to +9
// 								 | (signs.x < 0.0 ? 128U : 0U)					// + 3 sign bits, one for each component
// 								 | (signs.y < 0.0 ?  64U : 0U)
// 								 | (signs.z < 0.0 ?  32U : 0U);
// 
// 				return (exponent << 24U) | (RGB.x << 16U) | (RGB.y << 8U) | RGB.z;
