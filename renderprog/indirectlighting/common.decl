		#else
			$(indirectLighting/SH3)	LoadProbeSH( uint _probeID ) {
				$(indirectLighting/SH3_Order2)	Probe_Order2 = $(indirectLighting/bufferProbesSH_Order2)[_probeID];
				$(indirectLighting/SH3)			Probe;
				Probe.SH[0] = Probe_Order2.SH[0];
				Probe.SH[1] = Probe_Order2.SH[1];
				Probe.SH[2] = Probe_Order2.SH[2];
				Probe.SH[3] = Probe_Order2.SH[3];
				// The compiler should whine about non-initialized coefficients (4 through 8) ONLY IF we attempt to use them...
