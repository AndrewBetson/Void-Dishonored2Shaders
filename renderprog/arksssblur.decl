	hlsl_vp_main {
		#inlinefile <includes/arkVertex.inc>

		VertexInContext victx;
		INIT_VERTEXIN(victx)
		VertexOutContext vout = TransformVertex( victx );

		@sv_position = vout._projPosition;

		@SSS_linearDepth.x = -vout._viewPosition.z;

		@texcoords = vout._texcoords;
	}

	hlsl_fp_attribs {
		#ifdef ORBIS
			#if $alphaTest
				[RE_Z]
			#endif
		#endif
	}

	hlsl_fp_main {
		#inlinefile <includes/arkPixel.inc>
		arkPixelContext_t pixelCtx;
		INIT_PIXELCONTEXT( pixelCtx, 0 );
		arkMtrEffectContext_t effectCtx;
		effectCtx.InitMaterialEffect( pixelCtx );

		HQ_FetchMasks( pixelCtx );
		HQ_FetchDiffuseAlbedo( pixelCtx );

		float2 UV = screenPosToTexcoord( $sv_position.xy + $(subpixelOffset).xy, $positionToViewTexture);

		float linearDepth = $SSS_linearDepth.x;
		float2 tanFov = $globalViewInfos.xy;

//		float3 vsNormal = normalize( IN.vsNormal );
//		float2 perspectiveCorrection = pow( abs( vsNormal.xy ), c_PerspCorrectionPow ) * c_PerspCorrectionScale; //TODO ...
float2 perspectiveCorrection = float2(0,0);

		float2 blurWidth = $(SSS/Scale).x;

		#if( $(materialeffects/layerchange/enable) != 0 )
			blurWidth = lerp( blurWidth * (1.0 - effectCtx.rawFxColor.w), blurWidth, $(materialEffects/layerchange/sssFactor).x );
		#endif

		#if $(SSS/hasMask)
			blurWidth *= $(SSS/Mask).Sample( $bilinearSampler, $texcoords.xy ).x;
		#endif

		blurWidth *= $resolutionScale.xy;
		blurWidth /= ( linearDepth.xx + perspectiveCorrection ) * tanFov;

		float3 diffuse = float3( 0, 0, 0 );
		float3 weight = float3( 0, 0, 0 );

		[unroll]
		for( int i=0 ; i < numSkinProfileSamples ; ++i )
		{
			float2 dUV = skinProfileSamples[i].xy * blurWidth;
			float3 diffuseSample = $textureMap.Sample( $pointSampler, UV + dUV ).rgb;
			float3 profileWeights = skinProfileWeights[i].xyz;

			diffuse += diffuseSample * profileWeights;
			weight += profileWeights;
		}

		diffuse /= weight;
		diffuse.xyz = RangeExpandColorFromR11G11B10( diffuse.xyz ); 

		float3 emissive = HQ_FetchEmissive( pixelCtx );
		float3 albedo = pixelCtx.m_diffuseAlbedo.xyz;


		effectCtx.ApplyMaterialEffect_SSSBlur( pixelCtx, emissive, albedo );

		float3 finalColor = (diffuse * albedo) + emissive;
		//finalColor = ComputeFogWithLightScattering( finalColor, result.accumScattering.rgb, pixelCtx);

		@sv_target.xyz = RangeCompressColorToR11G11B10( finalColor );
		@sv_target.w = 1.0;
	}
}