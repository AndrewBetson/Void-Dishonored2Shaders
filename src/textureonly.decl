{ newstyle
	parms {
		stageSort	sortCoverage
	}
	state {
		alphaWrite 0
	}
	hlsl_prefix {
		#include <vertex>
	}
	hlsl_vp_main {
		#inlinefile <includes/arkVertex.inc>

		VertexInContext victx;
		INIT_VERTEXIN(victx)
		VertexOutContext vout = TransformVertex( victx );
		
		@sv_position = vout._projPosition;
		@legacy_texcoord.xy = $vertex_texcoord.xy * $vertexStScaleBias.xy + $vertexStScaleBias.zw;
		@legacy_texcoord.zw = float2( 0.f, 0.f );
	}
	hlsl_fp_main {
		@sv_target = $textureMap.Sample( $anisotropicSampler, $legacy_texcoord.xy );
	}
}