{
	newstyle

	state {
		depthEnable	0
		depthfunc	ALWAYS
		cull none
	}

	hlsl_prefix {
		#include <vertex>
	}

	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord  = $vertex_texcoord;
	}

	hlsl_fp_main {

		float odepth;
		float4 depths = $(Downscale/BufferDepthIn).Gather( $pointClamp, $texcoord.xy );

		#if $(Downscale/TYPE) == 1	// DEPTH_MAX
			float2 depthMax = max(depths.xy, depths.zw);
			odepth = max(depthMax.x, depthMax.y);
		#else //DEPTH_MIN
			float2 depthMin = min(depths.xy, depths.zw);
			odepth = min(depthMin.x, depthMin.y);
		#endif

		@sv_depth = odepth;
	}
}