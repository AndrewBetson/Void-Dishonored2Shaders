{
	newstyle

	parms {

	}

	state {
		blend		ONE ZERO
		depthWrite	0
		depthEnable	0
		depthfunc	ALWAYS
		cull none
	}

	hlsl_prefix {
		#include <dof>
	}

	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord = $vertex_texcoord;
	}

	hlsl_fp_main {
		float3 colorOut     = 0.0;

		#if $(PostFX/DOF/USE_VIGNETTING)
			colorOut = vignette($texcoord, $(PostFX/DOF/center).xy, $(PostFX/DOF/vignParams));
		#else
			//Unpack register
			float nearFuzzy = $(PostFX/DOF/Debug/aPlanes).x;	//in meter
			float nearSharp = $(PostFX/DOF/Debug/aPlanes).y;	//in meter
			float farSharp  = $(PostFX/DOF/Debug/aPlanes).z;	//in meter
			float farFuzzy  = $(PostFX/DOF/Debug/aPlanes).w;	//in meter
			float focal     = $(PostFX/DOF/Debug/aFocal).x;		//in meter
			float farDof	= ($(POSTFX/DOF/CommonParams).x);

			#if $(PostFX/DOF/AUTOFOCUS)
				focal = $(PostFX/DOF/ZbufferAutofocus).SampleLevel( $pointClamp, $(PostFX/DOF/center).xy, 0.0 ).x;
				farDof += focal;
				nearFuzzy = (nearFuzzy + focal) / farDof;
				nearSharp = (nearSharp + focal) / farDof;
				farSharp = (farSharp + focal) / farDof;
				farFuzzy = (farFuzzy + focal) / farDof;
			#endif

			//Fetch FrameBuffer
			const float3 RGB_TO_GREYSCALE = float3(0.2989f, 0.5870f, 0.1140f);	//linear luminance
			const float3 RGB_TO_LUMINANCE = float3(0.2126f, 0.7152f, 0.0722f);	//perceptual luminance
			float3 color = $(PostFX/DOF/Debug/sDiffuseMap).SampleLevel($bilinearClamp, $texcoord, 0.0).rgb;
			float  colorGrey = dot(color.rgb, RGB_TO_GREYSCALE);
			float  colorLum = dot(color.rgb, RGB_TO_LUMINANCE);

			//Fetch DepthBuffer
			float depth = $(PostFX/DOF/Debug/sDepthMap).SampleLevel( $pointClamp, $texcoord, 0.0 ).z;
			float depthLinear = LinearStep(0, farDof, depth);

			//Fetch Dof Fuzziness
			float2 dofMaskRaw = $(PostFX/DOF/Debug/sDofMask).SampleLevel($bilinearClamp, $texcoord, 0.0).rg;
			float  dofMaskNear = dofMaskRaw.r;
			float  dofMaskFar = dofMaskRaw.g;

			//Set Debug Color
			const float3 colorSharp   = float3(0,1,0);
			const float3 colorInFocus = float3(1,0,0);

			//Draw focus lines
			float  lineSize = 0.005;
			float3 nearLine  = Smootheststep(lineSize, 0, abs(depthLinear - nearSharp)) * colorSharp;
			float3 nearFuzzyLine  = Smootheststep(lineSize, 0, abs(depthLinear - nearFuzzy)) * colorSharp;
			float3 focusLine = Smootheststep(lineSize, 0, abs(depthLinear - focal    )) * colorInFocus;
			float3 farLine   = Smootheststep(lineSize, 0, abs(depthLinear - farSharp )) * colorSharp;
			float3 farFuzzyLine   = Smootheststep(lineSize, 0, abs( depthLinear - farFuzzy )) * colorSharp;

			//Draw focus area
			float3 colorFocusSharp = lerp(lerp(colorInFocus,color,0.9), color, colorGrey);
			float3 areaSharp = (depthLinear > nearSharp) * (depthLinear < farSharp) *colorFocusSharp;
			float3 colorFocusFuzzy = lerp(lerp(colorSharp,color,0.9), color, colorGrey);
			float3 areaFuzzy = (depthLinear > nearFuzzy) * (depthLinear < farFuzzy) *colorFocusFuzzy;
			float3 areaBox = areaSharp + areaFuzzy + nearLine + nearFuzzyLine + focusLine + farLine + farFuzzyLine;

			//Draw Dof strength
			float strengthNearFar = saturate(max(dofMaskNear,dofMaskFar));
			float3 areaBlur =  color * strengthNearFar;

			//Combine
			colorOut = areaBlur + areaBox;
			//colorOut = saturate( abs(depthLinear - focal) ) ;

		#endif

	@sv_target = float4(colorOut,1.0);
	}
}