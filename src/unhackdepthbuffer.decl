{
	newstyle
		options {
	}
	state {
		depthWrite 1		// Z write !
		depthfunc	ALWAYS	// No Z read
		depthEnable	0
		cull none
		blend		ZERO SRC_COLOR
	}
	hlsl_prefix {
	}
	hlsl_vp_main {
		@sv_position = float4( $vertex_position.xyz, 1 );
		@texcoord = $vertex_texcoord;
	}
	hlsl_fp_main {
		float Z = $(unhackDepth/depthView).Sample( $pointClamp, $texcoord ).x;
		@sv_depth = Z * $modelDepthHack.x;
	}
}