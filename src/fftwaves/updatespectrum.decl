{
	newstyle
	options {	
		NUMTHREADX 16
		NUMTHREADY 16
		NUMTHREADZ 1
	}
	
	hlsl_prefix {		
	}

	hlsl_cp_main {
		uint3 DTid = $sv_dispatchThreadID;

		int in_index = DTid.y * $(FFTWaves/InWidth).x + DTid.x;
		int in_mindex = ($(FFTWaves/ActualDim).x - DTid.y) * $(FFTWaves/InWidth).x + ($(FFTWaves/ActualDim).x - DTid.x);
		int out_index = DTid.y * $(FFTWaves/OutSize).x + DTid.x;

		// H(0) -> H(t)
		float2 h0_k  = $(FFTWaves/InputH0)[in_index];
		float2 h0_mk = $(FFTWaves/InputH0)[in_mindex];
		float sin_v, cos_v;
		sincos( $(FFTWaves/InputOmega)[in_index] * $localTime.x * $(ocean/TimeScale), sin_v, cos_v );

		float2 ht;
		ht.x = (h0_k.x + h0_mk.x) * cos_v - (h0_k.y + h0_mk.y) * sin_v;
		ht.y = (h0_k.x - h0_mk.x) * sin_v + (h0_k.y - h0_mk.y) * cos_v;

		// H(t) -> Dx(t), Dy(t)
		float kx = DTid.x - $(FFTWaves/ActualDim).x * 0.5f;
		float ky = DTid.y - $(FFTWaves/ActualDim).x * 0.5f;
		float sqr_k = kx * kx + ky * ky;
		float rsqr_k = 0;
		if (sqr_k > 1e-12f)
			rsqr_k = 1 / sqrt(sqr_k);
		//float rsqr_k = 1 / sqrtf(kx * kx + ky * ky);
		kx *= rsqr_k;
		ky *= rsqr_k;
		float2 dt_x = float2(ht.y * kx, -ht.x * kx);
		float2 dt_y = float2(ht.y * ky, -ht.x * ky);

		if ((DTid.x < $(FFTWaves/OutSize).x) && (DTid.y < $(FFTWaves/OutSize).y))
		{
			@(FFTWaves/OutputHt)[out_index] = ht;
			@(FFTWaves/OutputHt)[out_index + $(FFTWaves/DtAddressOffset).x ] = dt_x;
			@(FFTWaves/OutputHt)[out_index + $(FFTWaves/DtAddressOffset).y ] = dt_y;
		}
	}
}