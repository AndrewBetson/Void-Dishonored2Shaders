{
	newstyle

	options {
	}
	parms {
		stageSort	sortCoverage
	}
	state {
		blend SRC_ALPHA ONE_MINUS_SRC_ALPHA 
		blendOp ADD
		alphaBlend ONE ONE
		alphaBlendOp MAX
		
		depthfunc	ALWAYS
		depthEnable	0
		cull none
	}
	
	hlsl_prefix {
		#include <vertex>
	}
	
	hlsl_vp_main {
		#inlinefile <includes/arkVertex.inc>

		VertexInContext victx;
		INIT_VERTEXIN(victx)
		VertexOutContext vout = TransformVertex( victx );
				
		@sv_position = float4( $vertex_texcoord1.xy * 2 - 1, 0, 1 ); //vout._projPosition;
		@sv_position.y *= -1;
		@wsPosition = vout._worldPosition;
		@wsNormal = vout.m_wsNormal; 
	}

	hlsl_fp_main {

		float4x4 decalMatrix = float4x4( $decalUVMatrixX, $decalUVMatrixY, $decalUVMatrixZ, $decalUVMatrixW );
	
		float4 decalUV = mul( decalMatrix, float4( $wsPosition, 1 ) );
		
		clip( decalUV.z );
		clip( 1.0 - decalUV.z );

		decalUV.xy = decalUV.xy * 0.5f + 0.5f;
		float4 decal = $decalMap.Sample( $dynamicDecalSampler, decalUV.xy );

		float angleFix = dot( $decalDir.xyz, $wsNormal );
		angleFix = smoothstep( 0.3f, 0.5f, angleFix );
		decal.a *= angleFix;

		clip( decal.a - 0.00001f );

		@sv_target = decal;	
	}
}