{ newstyle
	parms {
	}

	hlsl_vp_main {
		float4 position = float4( $vertex_position.xyz, 1 );
		@sv_position.x = dot( position, $mvpMatrixX );
		@sv_position.y = dot( position, $mvpMatrixY );
		@sv_position.z = dot( position, $mvpMatrixZ );
		@sv_position.w = dot( position, $mvpMatrixW );
	}
	hlsl_fp_main {
		@sv_target = 1.0f.xxxx;
	}
}