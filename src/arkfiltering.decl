		//http://vec3.ca/bicubic-filtering-in-fewer-taps/
		float4 BiCubicInterpolation( Texture2D<float4> _tex, float2 _uv )
		{
			float2 texSize;
			float2 sampleWeight[3];
			float2 samplePos[3];

			_tex.GetDimensions( texSize.x, texSize.y );
					 
			_uv *= texSize;

			float2 tc = floor( _uv - 0.5f ) + 0.5f;
			float2 f = _uv - tc;
			float2 f2 = f * f;
			float2 f3 = f2 * f;

			float2 w0 = f2 - 0.5f * (f3 + f);
			float2 w1 = 1.5f * f3 - 2.5f * f2 + 1.0f;
			float2 w3 = 0.5f * (f3 - f2);
			float2 w2 = 1.0f - w0 - w1 - w3;
			
			sampleWeight[0] = w0;
			sampleWeight[1] = w1 + w2;
			sampleWeight[2] = w3;

			samplePos[0] = tc - 1.0f;
			samplePos[1] = tc + w2 / sampleWeight[1];
			samplePos[2] = tc + 2.0f;
		 
			float2 rcpTexSize = 1.0f / texSize;
		 
			samplePos[0] *= rcpTexSize;
			samplePos[1] *= rcpTexSize;
			samplePos[2] *= rcpTexSize;
			
			float4 color;
			color  = _tex.SampleLevel( $bilinearSampler, float2( samplePos[0].x, samplePos[0].y ), 0.0f ) * sampleWeight[0].x * sampleWeight[0].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[1].x, samplePos[0].y ), 0.0f ) * sampleWeight[1].x * sampleWeight[0].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[2].x, samplePos[0].y ), 0.0f ) * sampleWeight[2].x * sampleWeight[0].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[0].x, samplePos[1].y ), 0.0f ) * sampleWeight[0].x * sampleWeight[1].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[1].x, samplePos[1].y ), 0.0f ) * sampleWeight[1].x * sampleWeight[1].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[2].x, samplePos[1].y ), 0.0f ) * sampleWeight[2].x * sampleWeight[1].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[0].x, samplePos[2].y ), 0.0f ) * sampleWeight[0].x * sampleWeight[2].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[1].x, samplePos[2].y ), 0.0f ) * sampleWeight[1].x * sampleWeight[2].y;
			color += _tex.SampleLevel( $bilinearSampler, float2( samplePos[2].x, samplePos[2].y ), 0.0f ) * sampleWeight[2].x * sampleWeight[2].y;
			
			return color;
		}
	}
}