{
	newstyle
	
	hlsl_prefix {
		//See http://www.paulinternet.nl/?page=bicubic
		float CubicInterpolation( float _p0, float _p1, float _p2, float _p3, float _x )
		{
			return _p1 + 0.5f * _x*(_p2 - _p0 + _x*(2.0f*_p0 - 5.0f*_p1 + 4.0f*_p2 - _p3 + _x*(3.0f*(_p1 - _p2) + _p3 - _p0)));
		}
/*
		//Brute force bicubic, see GPU Gems for a more optimal version
		float BiCubicInterpolation( Texture2D<float> _tex, float2 _uv )
		{
			float2 texSize;
			_tex.GetDimensions( texSize.x, texSize.y );
				
			float2 f = frac( _uv * texSize );

			float y0 = CubicInterpolation(	_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2(-1,-1) ),
											_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2( 0,-1) ),
											_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2( 1,-1) ),
