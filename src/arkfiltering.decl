			float y3 = CubicInterpolation(	_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2(-1,2) ),
											_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2( 0,2) ),
											_tex.SampleLevel( $pointSampler, _uv, 0.0f, int2( 1,2) ),
